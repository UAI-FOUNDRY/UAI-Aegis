# UAI Aegis settings. Copy to .env:   cp .env.example .env
# Every AEGIS_ setting is listed in backend/app/config.py.

AEGIS_ENV=dev

# Professor portal address(es) allowed to call the API from a browser
AEGIS_CORS_ORIGINS=http://localhost:5173

# Only allow college email addresses (comma-separated), e.g. AEGIS_ALLOWED_EMAIL_DOMAINS=uai.edu.in
AEGIS_ALLOWED_EMAIL_DOMAINS=

# Where student code runs: local_dev (Python only, NOT a sandbox) or judge0
AEGIS_EXECUTOR=local_dev
AEGIS_JUDGE0_URL=http://judge0:2358
AEGIS_JUDGE0_TOKEN=change-me-judge0-token

# Password of the compose PostgreSQL database
AEGIS_DB_PASSWORD=aegis-dev-only

# ---------------------------------------------------------------------- production
# Development uses built-in demo keys. For any real deployment generate your own:
#   docker compose run --rm api python -m app.cli gen-key
# and keep them OUT of git and off the database server. Losing AEGIS_DATA_KEYS means
# losing every encrypted answer and test case, so back them up somewhere safe.
#
# AEGIS_ENV=production
# AEGIS_DATA_KEYS=k1:<gen-key output>
# AEGIS_ACTIVE_DATA_KEY=k1
# AEGIS_AUDIT_KEY=<a different gen-key output>
# AEGIS_EXECUTOR=judge0
# AEGIS_REQUIRE_KNOWN_CLIENT=true
