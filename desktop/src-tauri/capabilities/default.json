{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only the commands the exam UI needs. No file system, shell or generic signing access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-login",
    "allow-change-password",
    "allow-logout",
    "allow-list-exams",
    "allow-start-exam",
    "allow-get-session",
    "allow-save-answer",
    "allow-run-code",
    "allow-submit-code",
    "allow-finish-exam",
    "allow-heartbeat",
    "allow-report-blocked-paste",
    "allow-precheck",
    "allow-quit-app"
  ]
}
